{
  "schema": 1,
  "surfaces": {
    "app": {
      "paths": [
        "index.html",
        "src/**"
      ]
    }
  },
  "protected": [
    "tests/**",
    "scripts/**",
    ".aikit/**",
    "README.md",
    "ASSETS.md",
    "COMMERCIAL.md",
    "LICENSE",
    "LICENSES/**",
    "REUSE.toml",
    "package.json",
    ".gitignore",
    "play.cmd",
    "play.sh",
    "assets/**",
    "src/**/*.test.*",
    "src/**/*.spec.*",
    "src/**/__tests__/**"
  ],
  "commands": {
    "fast": "node --test tests",
    "snapshot": "node scripts/ui-inventory.mjs"
  },
  "style": {
    "theme_paths": [
      "src/theme.css"
    ]
  },
  "limits": {
    "max_files": 12,
    "max_lines": 2400
  }
}